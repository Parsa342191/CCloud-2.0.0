<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV banner (320x180dp) shown in the Leanback launcher grid.
     Uses the app's real launcher icon (mipmap/ic_launcher) centered on a
     dark background, instead of a generic placeholder. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <solid android:color="#0F0F14" />
        </shape>
    </item>
    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher" />
</layer-list>
